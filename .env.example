# Only needed in production. Leave blank locally — the site falls back to http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase (Project Settings → API). Leave blank to keep using the built-in sample catalogue.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Needed for admin writes (products, photos, orders, promotions).
# Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
